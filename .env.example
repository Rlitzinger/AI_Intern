# AI Intern Configuration
# Copy this to .env and modify as needed

# Models
AI_INTERN_PLANNING_MODEL=qwen2.5:7b-instruct
AI_INTERN_CODING_MODEL=qwen2.5-coder:7b-instruct
AI_INTERN_VALIDATION_MODEL=qwen2.5:7b-instruct
AI_INTERN_RESEARCH_MODEL=qwen2.5:7b-instruct

# Temperatures
AI_INTERN_PLANNING_TEMP=0.3
AI_INTERN_CODING_TEMP=0.1
AI_INTERN_VALIDATION_TEMP=0.2
AI_INTERN_RESEARCH_TEMP=0.3

# Execution
AI_INTERN_OLLAMA_BASE_URL=http://localhost:11434
AI_INTERN_MAX_RETRIES=2
AI_INTERN_CODE_EXEC_TIMEOUT=15
AI_INTERN_SERVER_STARTUP_TIMEOUT=8
AI_INTERN_LLM_CALL_TIMEOUT=120

# Paths
AI_INTERN_DB_PATH=ai_intern_db.sqlite

# Planning
AI_INTERN_USE_HIERARCHICAL_PLANNING=true
AI_INTERN_MAX_DECOMPOSITION_DEPTH=3

# Logging
AI_INTERN_LOG_LEVEL=INFO
